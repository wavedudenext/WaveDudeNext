<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:WaveDudeNext.App.Dialogs"
        x:Class="WaveDudeNext.App.Dialogs.MemoryWarningWindow"
        Title="{Binding #view.(dialogs:DialogFrame.Title)}" Icon="/Assets/wavedudenext.ico"
        Width="500" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="MemoryWarningWindow">
	<!-- the memory warning's window on a desktop: the frame around the warning's view (MemoryWarningView.axaml), which is
	     the dialog; the browser head, which has no windows, shows the same view over its main view -->
	<dialogs:MemoryWarningView x:Name="view" />
</Window>
