<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:WaveDudeNext.App.Dialogs"
        xmlns:help="using:WaveDudeNext.App.Help"
        x:Class="WaveDudeNext.App.Help.ManualWindow"
        Title="{Binding #view.(dialogs:DialogFrame.Title)}" Icon="/Assets/wavedudenext.ico"
        Width="1200" Height="820" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="ManualWindow">
	<!-- Help > Manual's window on a desktop: the frame around the manual's view (ManualView.axaml), which is the
	     manual; the browser head, which has no windows, shows the same view over its main view. Owned by the main
	     window (the user's choice): not modal, but minimised and closed with it -->
	<help:ManualView x:Name="view" />
</Window>
