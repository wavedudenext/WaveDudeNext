<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:WaveDudeNext.App.Dialogs"
        xmlns:help="using:WaveDudeNext.App.Help"
        x:Class="WaveDudeNext.App.Help.AboutWindow"
        Title="{Binding #view.(dialogs:DialogFrame.Title)}" Icon="/Assets/wavedudenext.ico"
        Width="600" SizeToContent="Height" MinWidth="480" MinHeight="620" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="AboutWindow">
	<!-- Help > About's window on a desktop: the frame around the About view (AboutView.axaml), which is the dialog; the
	     browser head, which has no windows, shows the same view over its main view. Sized to its content at first and
	     resizable: the license document takes the extra height while it is shown, otherwise the view's filler row above
	     the buttons does (the sizing is the code-behind's) -->
	<help:AboutView x:Name="view" />
</Window>
